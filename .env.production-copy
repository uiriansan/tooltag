# DEV
NODE_ENV=production

# Porta usada pelo servidor:
VITE_PORT=3000

# Navegadores modernos requerem uma conexão HTTPS segura para liberarem acesso à câmera.
# Use a opção abaixo para habilitar ou desabilitar a geração de chaves CA locais pelo servidor NodeJS.
# Se optar por usar um proxy reverso externo (ex., Nginx) para redirecionar requisições,
# desative a opção abaixo e configure a conexão HTTPS no proxy.
# `1` = habilitado, `0` = desabilitado
VITE_USE_HTTPS=0

# Lista de hosts usados para gerar as chaves CA.
# Adicione o IP do servidor, se necessário.
# Ignorado se `VITE_USE_HTTPS` estiver desativado.
VITE_HTTPS_HOSTS=localhost,127.0.0.1,192.168.0.100,tooltag.local

# Onde o banco de dados será salvo:
DB_PATH=./data/prod/production.sqlite
# Diretório onde backups e uploads serão salvos:
DATA_PATH=./data/prod

# Se o app deve salvar logs em arquivos.
# Se desativado, logs serão enviados para stdout e stderr
# Recomendável desativar caso a aplicação rode em Docker
# Esta opção é ignorada em ENV = `development`
# `1` = habilitado, `0` = desabilitado
LOG_TO_FILE=1

# Nome atribuído ao usuário administrador criado automaticamente:
ADM_USERNAME=

# Senha atribuída ao usuário administrador criado automaticamente.
# Esta senha pode ser alterada pelo sistema.
# Também será a senha padrão em caso de reset.
ADM_SENHA=
