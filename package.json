{
    "name": "tooltag",
    "private": true,
    "version": "0.0.1",
    "author": "Willian Santos <github.com/uiriansan>",
    "type": "module",
    "scripts": {
        "dev": "vite dev",
        "build": "vite build",
        "preview": "vite preview",
        "prepare": "svelte-kit sync || echo ''",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "dev:db:seed": "tsx --env-file=.env.development src/lib/server/db/seed.ts",
        "dev:db:generate": "dotenv -e .env.development -- drizzle-kit generate --config=src/lib/server/db/drizzle.config.ts",
        "dev:db:migrate": "tsx --env-file=.env.development src/lib/server/db/migrate.ts",
        "dev:db:push": "dotenv -e .env.development -- drizzle-kit push --config=src/lib/server/db/drizzle.config.ts",
        "dev:db:studio": "dotenv -e .env.development -- drizzle-kit studio --config=src/lib/server/db/drizzle.config.ts",
        "prod:db:generate": "dotenv -e .env.production -- drizzle-kit generate --config=src/lib/server/db/drizzle.config.ts",
        "prod:db:migrate": "tsx --env-file=.env.production src/lib/server/db/migrate.ts",
        "prod:db:push": "dotenv -e .env.production -- drizzle-kit push --config=src/lib/server/db/drizzle.config.ts",
        "prod:db:studio": "dotenv -e .env.production -- drizzle-kit studio --config=src/lib/server/db/drizzle.config.ts",
        "prod:start": "dotenv -e .env.production -- node build/index.js"
    },
    "devDependencies": {
        "@iconify-json/fluent": "^1.2.53",
        "@sveltejs/adapter-auto": "^7.0.1",
        "@sveltejs/adapter-node": "^5.5.7",
        "@sveltejs/kit": "^2.63.0",
        "@sveltejs/vite-plugin-svelte": "^7.1.2",
        "@tailwindcss/vite": "^4.3.0",
        "@types/bcrypt": "^6.0.0",
        "@types/better-sqlite3": "^7.6.13",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node-cron": "^3.0.11",
        "dotenv-cli": "^11.0.0",
        "drizzle-kit": "^0.31.10",
        "drizzle-seed": "^0.3.1",
        "svelte": "^5.56.1",
        "svelte-check": "^4.6.0",
        "tailwindcss": "^4.3.0",
        "tsx": "^4.23.0",
        "typescript": "^6.0.3",
        "unplugin-icons": "^23.0.1",
        "vite": "^8.0.16",
        "vite-plugin-mkcert": "^2.1.0"
    },
    "dependencies": {
        "@humanspeak/svelte-virtual-list": "^0.5.11",
        "@popperjs/core": "^2.11.8",
        "bcrypt": "^6.0.0",
        "better-sqlite3": "^12.11.1",
        "drizzle-orm": "^0.45.2",
        "flowbite": "^4.0.2",
        "jsonwebtoken": "^9.0.3",
        "node-cron": "^4.6.0",
        "qr-scanner": "^1.4.2",
        "tailwind-merge": "^3.6.0",
        "winston": "^3.19.0",
        "winston-daily-rotate-file": "^5.0.0"
    },
    "allowScripts": {
        "esbuild@0.18.20": true,
        "esbuild@0.25.12": true,
        "esbuild@0.28.1": true,
        "better-sqlite3@12.11.1": true,
        "sharp@0.34.5": true,
        "workerd@1.20260708.1": true,
        "bcrypt@6.0.0": true
    }
}
